import java.util.Scanner;

public class BusReservation {

public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);

    
    String[] busNames = {"Green Line Express", "Royal Travels", "City Rider", "Night Star", "Sky Coach"};
    String[] routes   = {"Hyderabad -> Bangalore", "Chennai -> Hyderabad", "Pune -> Mumbai",
                         "Delhi -> Jaipur", "Bangalore -> Goa"};
    int[] seats       = {40, 35, 30, 25, 20};
    double[] prices   = {1200.0, 950.0, 450.0, 700.0, 1500.0};

    int choice;

    
    do {
        System.out.println();
        System.out.println("===== INTERCITY BUS RESERVATION =====");
        System.out.println("1. View Available Buses");
        System.out.println("2. Reserve Tickets");
        System.out.println("3. Exit");
        System.out.print("Enter your choice: ");
        choice = sc.nextInt();

        switch (choice) {
            case 1:
                
                displayBuses(busNames, routes, seats, prices);
                break;
            case 2:
               
                reserveTicket(sc, busNames, routes, seats, prices);
                break;
            case 3:
                System.out.println("Thank you for using the Bus Reservation System. Happy journey!");
                break;
            default:
                System.out.println("Invalid choice. Please enter 1, 2 or 3.");
        }
    } while (choice != 3);

    sc.close();
}


static void displayBuses(String[] busNames, String[] routes, int[] seats, double[] prices) {
    System.out.println();
    System.out.println("----------- AVAILABLE BUSES -----------");
    for (int i = 0; i < busNames.length; i++) {
        System.out.println("Bus " + (i + 1) + ": " + busNames[i]);
        System.out.println("   Route : " + routes[i]);
        System.out.println("   Seats : " + seats[i]);
        System.out.println("   Price : Rs. " + prices[i] + " per ticket");
    }
    System.out.println("---------------------------------------");
}


static void reserveTicket(Scanner sc, String[] busNames, String[] routes, int[] seats, double[] prices) {
    displayBuses(busNames, routes, seats, prices);

    
    System.out.print("Enter bus number (1 to " + busNames.length + "): ");
    int busNumber = sc.nextInt();

   
    if (busNumber < 1 || busNumber > busNames.length) {
        System.out.println("Invalid bus number.");
        return; // go back to the menu
    }

    int index = busNumber - 1; 

    sc.nextLine(); 
    System.out.print("Enter passenger name: ");
    String name = sc.nextLine();

    System.out.print("Enter number of tickets: ");
    int tickets = sc.nextInt();

    
    if (tickets <= 0) {
        System.out.println("Number of tickets must be greater than 0.");
    } else if (tickets <= seats[index]) {

        
        double totalAmount = tickets * prices[index];
        double discount = 0;
        if (tickets >= 5) {
            discount = totalAmount * 0.10; // 10% off for 5 or more tickets
        }
        double finalAmount = totalAmount - discount;

        
        seats[index] = seats[index] - tickets;

       
        System.out.println();
        System.out.println("======= RESERVATION CONFIRMED =======");
        System.out.println("Passenger     : " + name);
        System.out.println("Bus           : " + busNames[index]);
        System.out.println("Route         : " + routes[index]);
        System.out.println("Tickets       : " + tickets);
        System.out.println("Total Amount  : Rs. " + totalAmount);
        System.out.println("Discount      : Rs. " + discount);
        System.out.println("Final Amount  : Rs. " + finalAmount);
        System.out.println("Seats Left    : " + seats[index]);
        System.out.println("=====================================");
    } else {
        System.out.println("Sorry, only " + seats[index] + " seats are available on this bus.");
    }
}
}
